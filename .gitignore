# Local configuration — never commit real credentials.
/config/config.php

# Runtime uploads and logs.
/storage/
*.log

# OS / editor cruft.
.DS_Store
Thumbs.db
.vscode/
.idea/

# Dependency directories (if any tooling is added later).
/vendor/
/node_modules/

# Server-generated files.
error_log
/public/.well-known/

# CMS image uploads (the directory's .htaccess is tracked).
/public/uploads/*
!/public/uploads/.htaccess
